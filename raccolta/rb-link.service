[Unit]
Description=RB-Vecchi raccolta: ping dei nodi di rete
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rbraccolta
Group=rbraccolta
Environment=RB_RACCOLTA_DIR=/var/lib/rb-raccolta
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0022
ExecStart=/usr/bin/python3 /opt/rb-raccolta/rb-link.py
Restart=always
RestartSec=10

# ping_group_range del sistema non ammette il ping non privilegiato e con
# NoNewPrivileges la capability di /usr/bin/ping non vale: la dà l'unità.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rb-raccolta
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
